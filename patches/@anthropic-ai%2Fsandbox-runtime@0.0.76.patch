diff --git a/dist/sandbox/explicit-asset.js b/dist/sandbox/explicit-asset.js
new file mode 100644
--- /dev/null
+++ b/dist/sandbox/explicit-asset.js
@@ -0,0 +1,30 @@
+import { createHash } from 'node:crypto';
+import { lstatSync, readFileSync } from 'node:fs';
+const snapshots = new Map();
+export function resolveExplicitAsset(file, label) {
+    let info;
+    try {
+        info = lstatSync(file, { bigint: true });
+    }
+    catch {
+        throw new Error(`${label} is missing`);
+    }
+    if (!info.isFile() || info.isSymbolicLink()) {
+        throw new Error(`${label} is not a regular file`);
+    }
+    const bytes = readFileSync(file);
+    const after = lstatSync(file, { bigint: true });
+    if (!after.isFile() || after.isSymbolicLink() || info.dev !== after.dev || info.ino !== after.ino ||
+        info.size !== after.size || info.mtimeNs !== after.mtimeNs) {
+        throw new Error(`${label} changed during resolution`);
+    }
+    const digest = createHash('sha256').update(bytes).digest('hex');
+    const fingerprint = `${after.dev}:${after.ino}:${after.size}:${after.mtimeNs}:${digest}`;
+    const key = `${label}\0${file}`;
+    const previous = snapshots.get(key);
+    if (previous !== undefined && previous !== fingerprint) {
+        throw new Error(`${label} changed after resolution`);
+    }
+    snapshots.set(key, fingerprint);
+    return file;
+}
